<?xml version="1.0" encoding="utf-8"?>
<!-- An autofill chip's pill, drawn by the autofill service and tinted with the keyboard's key colour
     (InlineAutofill). The ripple's grey reads on both the light and dark key colours. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33808080">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</ripple>
