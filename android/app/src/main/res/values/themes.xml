<resources>
    <style name="HexApp" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
    </style>
    <style name="HexIme" parent="android:style/Theme.InputMethod">
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/kb_background</item>
        <item name="android:windowBackground">@color/kb_background</item>
    </style>
</resources>
